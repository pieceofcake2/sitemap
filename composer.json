{
    "name": "pieceofcake2/sitemap",
    "description": "A CakePHP 2 Plugin for adding automatic XML and HTML Sitemaps to an app",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "model", "behavior", "sitemap"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "*",
        "pieceofcake2/cakephp": "^2.10"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.1",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "replace": {
        "loadsys/cakephp_sitemap": "^1.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Sitemap"
    }
}
