{
    "name": "pieceofcake2/sitemap",
    "description": "Automatic XML and HTML sitemaps for CakePHP 2 applications",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "model", "behavior", "sitemap"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.0"
    },
    "replace": {
        "loadsys/cakephp_sitemap": "^1.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Sitemap"
    }
}
